FROM node:18-alpine

WORKDIR /app

# TTS PCM→mp3 변환(ttsService._pcmToMp3)에서 ffmpeg 사용
RUN apk add --no-cache ffmpeg

COPY package*.json ./

RUN npm ci --only=production

COPY . .

RUN chmod +x /app/docker-entrypoint.sh && cp /app/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

EXPOSE 5100

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["npm", "start"]
