# 결제 웹 환경변수 (.env.local 로 복사해 채움 — 절대 커밋 금지)

# 백엔드 연동
BACKEND_INTERNAL_URL=http://codingpt_back:5100          # SSR 서버사이드 호출(도커 내부망). 미설정 시 PUBLIC 사용
NEXT_PUBLIC_BACKEND_URL=https://codingpt-back.ghmate.com # 클라이언트 호출

# PortOne V2 (publishable — 클라이언트 노출용. API_SECRET 은 백엔드만 보유)
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxxxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_CHARGE=channel-key-충전(신용카드 일시불)
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_BILLING=channel-key-구독(빌링키)

# (선택) 직접 구글 로그인용 — 미설정 시 ID/PW + 앱 핸드오프만 사용
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
