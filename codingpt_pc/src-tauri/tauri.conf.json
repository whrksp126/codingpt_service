{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodingPT",
  "mainBinaryName": "CodingPT",
  "version": "0.1.217",
  "identifier": "com.ghmate.codingpt.pc",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "CPT_RELEASE=1 bash scripts/bundle-sidecar.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CodingPT",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "codingpt-pc"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4Q0QxQUQ1MTMxRjU0OTYKUldTV1ZCOFQxUnJOU0hJY2RBSll4Y2tHZWdCelB2Rm9NbUVtbTdtNnBnamRvWVdzV1JtK2dkdVcK",
      "endpoints": [
        "https://codingpt-back.ghmate.com/api/pc/update/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/daemon"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: GeonHo Jo (BB8GGQPRRX)"
    },
    "createUpdaterArtifacts": true
  }
}
