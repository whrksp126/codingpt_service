{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodingPT",
  "version": "0.1.0",
  "identifier": "com.ghmate.codingpt.pc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CodingPT",
        "width": 440,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "center": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["codingpt-pc"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/daemon"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
