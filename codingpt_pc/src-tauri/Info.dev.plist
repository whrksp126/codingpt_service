<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 네이티브 대화상자(폴더 피커 등)를 한글로 표시하기 위한 지역화 선언.
       macOS 는 앱 번들의 지역화 목록 + 사용자 선호 언어로 NSOpenPanel 언어를 결정한다.
       (빌드된 .app 에 반영됨. dev 바이너리는 번들이 아니라 영어로 뜰 수 있음.) -->
  <key>CFBundleDevelopmentRegion</key>
  <string>ko</string>
  <key>CFBundleAllowMixedLocalizations</key>
  <true/>
  <key>CFBundleLocalizations</key>
  <array>
    <string>ko</string>
    <string>en</string>
  </array>
</dict>
</plist>
