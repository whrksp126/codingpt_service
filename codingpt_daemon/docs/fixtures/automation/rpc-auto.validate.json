{
  "contract": "docs/automation-design.md §5.6 — 데몬 automations.js(S1) 소유. test/automations.test.js 가 normalizeDraft 결과 모양과 대조한다.",
  "method": "auto.validate",
  "description": "draft 정규화(기본값 채움: name 없으면 트리거 라벨, guards 기본 10/1/300000, agents 기본 claude×1, subdir '', base null, copyEnv true, labels [], state 'open'). 이벤트/폴링 트리거는 nextRunAt null. warnings = §5.4 표에 없는 변수 등(거부 아님).",
  "params": {
    "draft": {
      "trigger": { "type": "github.issues", "repo": "work/codingpt", "labels": ["bug"] },
      "actions": [
        { "type": "task.create", "repo": "work/codingpt", "title": "{issue.title}", "prompt": "이슈 #{issue.number} '{issue.title}' 를 처리해라. 우선순위 {issue.priority}\n\n{issue.body}" }
      ]
    }
  },
  "result": {
    "ok": true,
    "normalized": {
      "v": 1,
      "name": "새 이슈",
      "enabled": true,
      "trigger": { "type": "github.issues", "repo": "work/codingpt", "labels": ["bug"], "state": "open" },
      "actions": [
        {
          "type": "task.create", "repo": "work/codingpt", "subdir": "", "base": null,
          "agents": [{ "id": "claude", "count": 1 }],
          "title": "{issue.title}",
          "prompt": "이슈 #{issue.number} '{issue.title}' 를 처리해라. 우선순위 {issue.priority}\n\n{issue.body}",
          "copyEnv": true
        }
      ],
      "guards": { "maxRunsPerDay": 10, "maxConcurrent": 1, "cooldownMs": 300000 }
    },
    "nextRunAt": null,
    "warnings": ["actions[0].prompt: 알 수 없는 변수 {issue.priority} — 빈 문자열로 치환됩니다"]
  },
  "errors": [
    { "draft": { "trigger": { "type": "schedule", "cron": "*/5 * * * *", "tz": "Asia/Seoul" }, "actions": [{ "type": "notify", "title": "x" }] }, "code": "AUTO_BAD_TRIGGER", "why": "최소 간격 15분" },
    { "draft": { "trigger": { "type": "webhook" }, "actions": [{ "type": "notify", "title": "x" }] }, "code": "AUTO_BAD_TRIGGER", "why": "지원하지 않는 트리거(§5.2 제외 목록)" },
    { "draft": { "trigger": { "type": "pr.ci_failed", "repo": null }, "actions": [{ "type": "shell", "cmd": "rm -rf /" }] }, "code": "AUTO_BAD_ACTION", "why": "액션은 task.create·terminal.prompt·notify 뿐" },
    { "draft": { "trigger": { "type": "schedule", "cron": "0 9 * * *", "tz": "Asia/Seoul" }, "actions": [{ "type": "terminal.prompt", "target": { "event": true }, "text": "x" }] }, "code": "AUTO_BAD_ACTION", "why": "target.event 는 pr.*/task.event 트리거에서만" },
    { "draft": { "trigger": { "type": "pr.ci_failed" }, "actions": [] }, "code": "AUTO_BAD_ACTION", "why": "액션 1~5개" }
  ]
}
