{
  "contract": "docs/agent-tasks-design.md §3.1 — 데몬 구현자 소유(§8.5). test/task-contract.test.js 가 pickTask/pickRun 화이트리스트와 대조한다.",
  "method": "*",
  "description": "에러 코드 정본(§2.13) + 3 경로에서 code 가 도착하는 자리. MERGE_CONFLICT 는 결과 코드(던지지 않음).",
  "codes": [
    "BAD_PARAMS",
    "PROMPT_TOO_LARGE",
    "TASK_NOT_FOUND",
    "RUN_NOT_FOUND",
    "TASK_CLOSED",
    "TASKS_DISABLED",
    "NOT_A_REPO",
    "BASE_NOT_FOUND",
    "BASE_MOVED",
    "TASK_LIMIT",
    "AGENT_NOT_INSTALLED",
    "GIT_MISSING",
    "GIT_CLT_MISSING",
    "GH_MISSING",
    "GH_NOT_AUTHED",
    "GH_ERROR",
    "NOT_GITHUB",
    "NO_REMOTE",
    "WORKTREE_ADD_FAILED",
    "WORKTREE_MISSING",
    "WORKTREE_REMOVE_FAILED",
    "AGENT_LAUNCH_FAILED",
    "LAUNCH_BUSY",
    "PROMPT_NOT_DELIVERED",
    "TERMINAL_GONE",
    "UNCOMMITTED_CHANGES",
    "UNMERGED_COMMITS",
    "NOTHING_TO_COMMIT",
    "NOTHING_TO_PR",
    "GIT_IDENTITY_MISSING",
    "GIT_LOCKED",
    "COMMIT_HOOK_FAILED",
    "GIT_SIGN_FAILED",
