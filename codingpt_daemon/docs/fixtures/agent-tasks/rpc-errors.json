  "resultOnlyCodes": [
    "MERGE_CONFLICT"
  ],
  "wire": {
    "sealed": {
      "note": "봉인 응답을 연 결과(e2ee.openRpcResult)",
      "example": {
        "ok": false,
        "e": "작업을 찾을 수 없습니다",
        "code": "TASK_NOT_FOUND"
      }
    },
    "relayPlain": {
      "note": "back POST /api/daemon/task 실패 — HTTP 500 body(데몬 rpc_result {error, code} → e.publicDetail={code})",
      "example": {
        "success": false,
        "message": "작업을 찾을 수 없습니다",
        "detail": {
          "code": "TASK_NOT_FOUND"
        }
      }
    },
    "relayTimeout": {
      "note": "릴레이 타임아웃은 back 이 TIMEOUT 으로 매핑",
      "example": {
        "success": false,
        "message": "데몬이 응답하지 않습니다(RPC 타임아웃).",
        "detail": {
          "code": "TIMEOUT"
        }
      }
    },
    "localSocket": {
      "note": "PC 로컬 소켓(task_local) — 문자열 접두 ^([A-Z_]+): 를 파싱",
      "example": "TASK_NOT_FOUND: 작업을 찾을 수 없습니다"
    }
  }
}
